{% import "_includes/forms" as forms %}

{% if error %}
    <div class="readable">
        <p class="error">{{ error }}</p>
    </div>
{% else %}
    <div class="pane">
        <p><strong>{{ count }}</strong> gecachte pagina’s</p>
        <p class="light"><code>{{ path }}</code></p>
    </div>
{% endif %}

{% if currentUser.can('cachekit:manage') %}
    <form method="post" class="utility">
        {{ csrfInput() }}
        {{ redirectInput('utilities/cachekit') }}
        {{ forms.textareaField({
            label: 'URL’s of patronen',
            instructions: 'Eén root-relative URL, dezelfde-site absolute URL of wildcard per regel.',
            id: 'cachekit-targets',
            name: 'targets',
            rows: 6,
            placeholder: '/artikelen/*'
        }) }}
        <div class="buttons">
            <button class="btn" name="action" value="cachekit/cache/clear">Wissen</button>
            <button class="btn submit" name="action" value="cachekit/cache/refresh">Verversen</button>
        </div>
    </form>
{% endif %}

{% if currentUser.can('cachekit:clearAll') %}
    <hr>
    <form method="post" class="utility">
        {{ csrfInput() }}
        {{ redirectInput('utilities/cachekit') }}
        {{ actionInput('cachekit/cache/clear-all') }}
        <button class="btn formsubmit" data-confirm="Weet je zeker dat je de volledige paginacache wilt legen?">
            Alles legen
        </button>
    </form>
{% endif %}

{% if snapshotConfigured %}
    <hr>
    <h2>Noodkopie</h2>
    {% if emergencyActive %}
        <p class="error">De noodmodus staat aan: bezoekers krijgen de noodkopie te zien.</p>
    {% endif %}
    <div class="pane">
        {% if snapshotManifest %}
            <p><strong>{{ snapshotManifest.pages }}</strong> pagina’s, gebouwd {{ snapshotManifest.builtAt|datetime('short') }}</p>
            {% if snapshotManifest.failures|length %}
                <p class="warning">{{ snapshotManifest.failures|length }} URL’s mislukt bij de laatste build.</p>
            {% endif %}
        {% else %}
            <p class="warning">Er is nog geen noodkopie gebouwd.</p>
        {% endif %}
    </div>
    {% if currentUser.can('cachekit:snapshot') %}
        <form method="post" class="utility">
            {{ csrfInput() }}
            {{ redirectInput('utilities/cachekit') }}
            {{ actionInput('cachekit/cache/build-snapshot') }}
            <button class="btn">Noodkopie nu bouwen</button>
        </form>
    {% endif %}
{% endif %}
